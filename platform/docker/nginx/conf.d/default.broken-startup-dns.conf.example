server {
  listen 80;
  server_name _;
  # BROKEN ON PURPOSE (Day 2 debug): upstream resolved at start-up only.
  # After `docker compose up --build -d api`, this NGINX keeps the old IP → 502.
  location /api/ {
    proxy_pass http://api:3001;
  }
  location / {
    proxy_pass http://web:8080;
  }
}
