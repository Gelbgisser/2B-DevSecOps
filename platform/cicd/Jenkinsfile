pipeline {
  agent any
  environment {
    APP_URL = credentials('lab-app-url') // fallback below if not bound
    REGISTRY = 'localhost:5000'
    IMAGE = 'secure-demo-api'
  }
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Test API') {
      steps {
        dir('apps/secure-demo/api') {
          sh 'node --test test/*.test.js || npm test'
        }
      }
    }
    stage('SBOM') {
      steps {
        sh 'mkdir -p security/reports'
        sh 'syft dir:apps/secure-demo/api -o json > security/reports/sbom-api.json || echo "syft not installed on agent — install for capstone"'
        archiveArtifacts artifacts: 'security/reports/*.json', allowEmptyArchive: true
      }
    }
    stage('Build image') {
      steps {
        sh '''
          docker build -t ${REGISTRY}/${IMAGE}:${BUILD_NUMBER} apps/secure-demo/api
          docker tag ${REGISTRY}/${IMAGE}:${BUILD_NUMBER} ${REGISTRY}/${IMAGE}:latest
        '''
      }
    }
    stage('Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-lab', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''
            echo "$REG_PASS" | docker login ${REGISTRY} -u "$REG_USER" --password-stdin || true
            docker push ${REGISTRY}/${IMAGE}:${BUILD_NUMBER} || echo "lite mode: push skipped"
          '''
        }
      }
    }
  }
  post {
    always {
      echo 'Fail the build if tests failed. Credentials stay in Jenkins, not in this file.'
    }
  }
}
