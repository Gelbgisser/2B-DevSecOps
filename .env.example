# =============================================================================
# DevSecOps bootcamp — copy to .env and adjust. NEVER commit .env.
# All passwords below are LAB-ONLY. Rotate if this laptop ever leaves class.
# =============================================================================

# --- Public origin (browser + OIDC + mobile) ---
# The URL humans type. Must include the published edge port. Never invent :80.
NGINX_HTTP_PORT=3080
APP_URL=http://localhost:3080

# Day 9 (phone on the same Wi-Fi): the phone cannot use localhost.
# Use http://<YOUR_PC_LAN_IPv4>:3080 in the Expo/Flutter app (and optionally here
# if you want the API to emit that origin in links). Example:
# APP_URL=http://192.168.1.42:3080
# Do not bind nginx to 127.0.0.1 only — Compose publishes 0.0.0.0:<port> so LAN works.

# Internal service ports (Compose network only — do NOT publish these on the host)
API_PORT=3001
WEB_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
CLAMAV_PORT=3310

# --- Demo database (Compose). Not a real secret — still gitignored via .env ---
POSTGRES_USER=secure_demo
POSTGRES_PASSWORD=lab-only-change-me
POSTGRES_DB=secure_demo
DATABASE_URL=postgres://secure_demo:lab-only-change-me@postgres:5432/secure_demo

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- ClamAV (Day 7). Host is the Compose/K8s DNS name, not localhost. ---
# Leave empty until Day 7 (`--profile clamav`). A hostname here makes uploads wait on ClamAV.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Mock session for early days (no real IdP). Stretch lab can replace this. ---
MOCK_USER_HEADER=X-Demo-User
MOCK_USER_DEFAULT=learner

# --- Day 5 CI (lite passwords — change per class, never reuse at work) ---
GITEA_HTTP_PORT=3000
JENKINS_HTTP_PORT=8090
NEXUS_HTTP_PORT=8081
REGISTRY_HTTP_PORT=5000
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASSWORD=lab-only-gitea
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=lab-only-jenkins
NEXUS_ADMIN_PASSWORD=lab-only-nexus

# --- Day 6 Vault (dev/lab token ONLY — never a production root token) ---
VAULT_DEV_ROOT_TOKEN=lab-only-vault-root
VAULT_HTTP_PORT=8200
VAULT_ADDR=http://vault:8200

# --- Day 6 Argo CD ---
ARGOCD_HTTP_PORT=8088

# --- Optional Cloudflare Tunnel (Day 7). Leave empty unless you opt in. ---
# CLOUDFLARE_TUNNEL_TOKEN=
# TUNNEL_HOSTNAME=

# --- Terraform / k3s VM (Day 3+). Fill after the Linux VM exists. ---
K3S_HOST=
K3S_KUBECONFIG_PATH=/etc/rancher/k3s/k3s.yaml
KUBE_CONTEXT=default
