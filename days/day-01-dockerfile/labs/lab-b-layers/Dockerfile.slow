# Intentionally SLOW cache: copying the whole tree first means ANY file
# change invalidates "npm install" (even a README typo).
FROM node:22-alpine
WORKDIR /app
COPY . .
# --omit=dev  skip devDependencies (smaller). || true = lab still builds without a lockfile.
RUN npm install --omit=dev || true
CMD ["node", "-e", "console.log('lab-b slow')"]
